# Copy to backend/.env and fill in. Never commit the real .env.

# ── required ──
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/caretaker
# quick demo without PostgreSQL (tested end-to-end):  DATABASE_URL=sqlite:///./caretaker_demo.db
SECRET_KEY=<any-long-random-string>
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Saathi / AI (Google AI Studio key: https://aistudio.google.com/apikey) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# optional extra fallbacks, comma-separated
GEMINI_FALLBACK_MODELS=
# leave EMPTY unless you really need a custom URL (it pins one model)
GEMINI_API_ENDPOINT=

# ── Saathi's natural voice (optional; browser voice is used without it) ──
# service-account JSON with Cloud Text-to-Speech enabled + billing
GOOGLE_APPLICATION_CREDENTIALS=

# ── fall detection pose model (optional) ──
# POSE_MODEL=yolov8s-pose.pt   # default; yolov8n-pose.pt is faster but misses people lying down
# POSE_IMGSZ=640               # 960 helps when people are small / far from the camera
# POSE_CONF=0.15

# ── optional ──
YOUTUBE_API_KEY=
WEATHER_API_KEY=
DEFAULT_CITY=Jammu
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
